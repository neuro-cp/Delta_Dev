+def _tentative_goal_topic(message: str) -> str:
+    lower = message.lower()
+    if "topic switch" in lower:
+        return "topic_switches"
+    if "geometry" in lower:
+        return "geometry"
+    if "reference" in lower or "implied" in lower:
