      "role": "user",
      "schema_version": "conversational_runtime_operation_marathon_1_v1",
      "text": "What color is the sky?",
      "turn_id": "conversation-turn-98ff51caebad5157"
    },
    {
      "created_at": "2026-07-27T17:24:24+00:00",
      "intent_type": "ordinary_response",
