DELTA_EVALUATOR_PROVIDER=openai
DELTA_EVALUATOR_API_KEY=put_key_here
DELTA_EVALUATOR_MODEL=gpt-4.1-mini
DELTA_EVALUATOR_ENABLED=false
DELTA_EVALUATOR_ALLOW_LIVE_CALL=false
DELTA_EVALUATOR_ENDPOINT=https://api.openai.com/v1/chat/completions
DELTA_EVALUATOR_SCHEDULE_ENABLED=false
DELTA_EVALUATOR_SCHEDULE_CADENCE=daily
DELTA_EVALUATOR_SCHEDULE_LOCAL_TIME=03:00
DELTA_EVALUATOR_SCHEDULE_DRY_RUN=true
DELTA_UNKNOWN_PROVIDER_ENABLED=false
DELTA_UNKNOWN_PROVIDER_ALLOW_LIVE_CALL=false
DELTA_UNKNOWN_PROVIDER_MODEL=gpt-4.1-mini
DELTA_UNKNOWN_PROVIDER_ENDPOINT=https://api.openai.com/v1/chat/completions
DELTA_SPECIALIST_ROUTING_ENABLED=false
DELTA_SPECIALIST_ALLOW_LIVE_CALL=false
DELTA_SPECIALIST_DEFAULT_PROVIDER=openai
DELTA_SPECIALIST_DEFAULT_MODEL=gpt-4.1-mini
